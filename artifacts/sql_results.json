  {
    "title": "Point-in-time prior returns vs later outcome using a window (not used as a model feature here)",
    "columns": [
      "history_group",
      "n_orders",
      "subsequent_return_rate"
    ],
    "rows": [
      {
        "history_group": "had_previous_return",
        "n_orders": 774,
        "subsequent_return_rate": 0.06330749354005168
      },
      {
        "history_group": "no_previous_return",
        "n_orders": 4235,
        "subsequent_return_rate": 0.05832349468713105
      }
    ],
    "sql": "-- Point-in-time prior returns vs later outcome using a window (not used as a model feature here)\nWITH ordered AS (\n    SELECT\n        customer_id,\n        order_id,\n        order_date,\n        returned,\n        SUM(returned) OVER (\n            PARTITION BY customer_id\n            ORDER BY order_date, order_id\n            ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING\n        ) AS previous_return_count\n    FROM orders\n)\nSELECT\n    CASE WHEN COALESCE(previous_return_count, 0) >= 1 THEN 'had_previous_return' ELSE 'no_previous_return' END AS history_group,\n    COUNT(*) AS n_orders,\n    AVG(returned) AS subsequent_return_rate\nFROM ordered\nGROUP BY history_group"
  }
